<UserControl x:Class="UpBot.Views.TradeHistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:UpBot.ViewModels">
    <UserControl.DataContext>
        <vm:TradeHistoryViewModel />
    </UserControl.DataContext>
    <StackPanel Margin="20">
        <TextBlock Text="거래내역 조회" FontSize="20" FontWeight="Bold" Margin="0,0,0,10"/>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
            <DatePicker SelectedDate="{Binding SelectedDate}" Width="150"/>
            <Button Content="조회" Command="{Binding SearchCommand}" Width="80" Margin="10,0,0,0"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="총 수익금액: " FontWeight="Bold"/>
            <TextBlock Text="{Binding TotalProfitAmount}" Margin="5,0,20,0"/>
            <TextBlock Text="총 수익률: " FontWeight="Bold"/>
            <TextBlock Text="{Binding TotalProfitPercent}" Margin="5,0,0,0"/>
        </StackPanel>
        <ListView ItemsSource="{Binding TradeHistories}">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="코인명" DisplayMemberBinding="{Binding CoinName}" Width="120"/>
                    <GridViewColumn Header="매수가" DisplayMemberBinding="{Binding BuyPrice}" Width="120"/>
                    <GridViewColumn Header="매도가" DisplayMemberBinding="{Binding SellPrice}" Width="120"/>
                    <GridViewColumn Header="수량" DisplayMemberBinding="{Binding Amount}" Width="120"/>
                    <GridViewColumn Header="수익 금액" DisplayMemberBinding="{Binding ProfitAmount}" Width="120"/>
                    <GridViewColumn Header="수익 퍼센트" DisplayMemberBinding="{Binding ProfitPercent}" Width="120"/>
                </GridView>
            </ListView.View>
        </ListView>
    </StackPanel>
</UserControl>