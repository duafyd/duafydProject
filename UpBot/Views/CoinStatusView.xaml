<UserControl x:Class="UpBot.Views.CoinStatusView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:UpBot.ViewModels">
    <UserControl.DataContext>
        <vm:CoinStatusViewModel />
    </UserControl.DataContext>
    <StackPanel Margin="20">
        <TextBlock Text="코인 현황" FontSize="20" FontWeight="Bold" Margin="0,0,0,10"/>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,10" VerticalAlignment="Center">
            <Ellipse Width="20" Height="20" Margin="0,0,10,0">
                <Ellipse.Style>
                    <Style TargetType="Ellipse">
                        <Setter Property="Fill" Value="Red"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                <Setter Property="Fill" Value="LimeGreen"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Ellipse.Style>
            </Ellipse>
            <Button Content="시작" Command="{Binding StartCommand}" Width="80" Margin="0,0,10,0"/>
            <Button Content="중지" Command="{Binding StopCommand}" Width="80" Margin="0,0,10,0"/>
            <Button Content="일괄 매도" Command="{Binding SellAllCommand}" Width="100"/>
        </StackPanel>
        <ListView ItemsSource="{Binding TradeHistories}">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="코인명" DisplayMemberBinding="{Binding CoinName}" Width="120"/>
                    <GridViewColumn Header="매수가" DisplayMemberBinding="{Binding BuyPrice}" Width="120"/>
                    <GridViewColumn Header="매도가" DisplayMemberBinding="{Binding SellPrice}" Width="120"/>
                    <GridViewColumn Header="수량" DisplayMemberBinding="{Binding Amount}" Width="120"/>
                    <GridViewColumn Header="수익 금액" DisplayMemberBinding="{Binding ProfitAmount}" Width="120"/>
                    <GridViewColumn Header="수익 퍼센트" DisplayMemberBinding="{Binding ProfitPercent}" Width="120"/>
                </GridView>
            </ListView.View>
        </ListView>
    </StackPanel>
</UserControl>