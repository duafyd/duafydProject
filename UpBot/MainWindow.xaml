<Window x:Class="UpBot.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:UpBot"
        xmlns:views="clr-namespace:UpBot.Views"
        xmlns:vm="clr-namespace:UpBot.ViewModels"
        mc:Ignorable="d"
        Title="UpBot" Height="600" Width="900">
    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>
    <Grid>
        <TabControl>
            <TabItem Header="코인현황">
                <views:CoinStatusView />
            </TabItem>
            <TabItem Header="거래내역 조회">
                <views:TradeHistoryView />
            </TabItem>
        </TabControl>
    </Grid>
</Window>
